# MySQL 容器
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=netdisk
MYSQL_USER=xuxiake
MYSQL_PASSWORD=change-me

# Java 服务数据库连接
DB_URL=jdbc:mysql://mysql:3306/netdisk?useUnicode=true&characterEncoding=UTF-8&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_DATABASE=0
REDIS_HOST=redis
REDIS_PORT=6379

# ZooKeeper
ZOOKEEPER_SERVERS=zookeeper:2181
ZOOKEEPER_CONNECT_TIMEOUT=15000
ZOOKEEPER_SESSION_TIMEOUT=30000

# Web 与文件服务
PUBLIC_SERVER_HOST=https://example.com
SESSION_COOKIE_SECURE=true
FASTDFS_TRACKER=fastdfs_tracker:22122
FASTDFS_CONNECT_TIMEOUT=3000
FASTDFS_SO_TIMEOUT=30000
FASTDFS_NGINX_SERVER=https://files.example.com
LIBREOFFICE_HOME=/usr/lib/libreoffice
LIBREOFFICE_PORTS=2002, 2003, 2004
USER_TOTAL_MEMORY=104857600
FILE_SIZE_MAX=52428800
VIP_FILE_SIZE_MAX=524288000
AVATAR_SIZE_MAX=5242880
MULTIPART_MAX_FILE_SIZE=500MB
MULTIPART_MAX_REQUEST_SIZE=1024MB
RECYCLE_DELAY_TIME=2592000000
RECYCLE_RECONCILE_INTERVAL=60000
STORAGE_DELETE_RETRY_INTERVAL=60000
MEDIA_CORE_POOL_SIZE=2
MEDIA_MAX_POOL_SIZE=4
MEDIA_QUEUE_CAPACITY=20

# 邮件
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_VERIFY_EXPIRE=86400000
EMAIL_CODE_EXPIRE=600000
EMAIL_SEND_INTERVAL=60000
EMAIL_MAX_VERIFY_ATTEMPTS=5

# 分享
SHARE_MAX_PASSWORD_ATTEMPTS=5
SHARE_PASSWORD_LOCK_TIME=600000

# 短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_MNS_ENABLED=false
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_CONTENT=
SMS_QUEUE_NAME=
SMS_VERIFY_EXPIRE=300000
SMS_SEND_INTERVAL=60000

# 第三方服务
TULING_API_KEY=
TULING_API_URL=http://openapi.tuling123.com/openapi/api/v2
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 对外服务配置
WEB_SERVER_PORT=8080
ROUTE_SERVER_PORT=9000
ROUTE_HOSTNAME=route
QUARTZ_SERVER_PORT=8200
QUARTZ_HOSTNAME=quartz
CHAT_SERVER_PORT=8100
CHAT_SERVER_HOSTNAME=chat-server
CHAT_SOCKET_PORT=9527
CHAT_SOCKET_IP=localhost
ADMIN_SERVER_PORT=8300
TOKEN_SECRET=change-to-a-long-random-value
